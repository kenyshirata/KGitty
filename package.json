{
  "name": "kgitty",
  "productName": "KGitty",
  "version": "0.2.19",
  "description": "A Fork-like Git client built with Electron",
  "author": "KGitty",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always",
    "i18n": "node tools/build-i18n.js",
    "icon": "electron tools/build-icon.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.kgitty.app",
    "productName": "KGitty",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KGitty",
      "artifactName": "KGitty-Setup-${version}.${ext}"
    },
    "afterPack": "build/afterPack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "kenyshirata",
        "repo": "KGitty",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
